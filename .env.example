# --- Runtime environment ---
ENV=dev
LOG_LEVEL=INFO
REGION_KEY=us-east-1

# --- Service ports (dev) ---
IDENTITY_PORT=8001
CATALOG_PORT=8002
STREAMING_PORT=8003
AI_GUIDE_PORT=8004

# --- Secrets (dev only - use KMS/SecretManager in prod) ---
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15

# --- Database ---
DATABASE_URL=sqlite:///./data/worldview.db
POSTGRES_USER=worldview
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=worldview

# --- AI Guide ---
AI_PROVIDER=mock
AI_MODEL_GATEWAY_URL=http://localhost:8005
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
