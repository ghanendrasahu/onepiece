# --- Runtime environment ---
ENV=dev
LOG_LEVEL=INFO
REGION_KEY=us-east-1

# --- Secrets (NEVER commit a real value here — copy to .env and generate your own) ---
# Generate one:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15

# CORS allowed origins, comma-separated. "*" is dev only.
CORS_ORIGINS=*

# --- Database ---
# Local default is SQLite; production/CI uses PostgreSQL. Non-dev rejects SQLite.
DATABASE_URL=sqlite:///./data/worldview.db
POSTGRES_USER=worldview
POSTGRES_PASSWORD=dev-password        # docker-compose only, local containers
POSTGRES_DB=worldview
# Connection-pool tuning (PostgreSQL only; ignored for SQLite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# CI test database (must be PostgreSQL to run the suite against a real DB).
# WORLDVIEW_TEST_DATABASE_URL=postgresql+psycopg://worldview:worldview@localhost:5432/worldview_test

# --- Gateway (single API entry point) ---
GATEWAY_PORT=8000
GATEWAY_RATE_LIMIT_RPM=600
# Optional direct TLS at the gateway (dev). Point GATEWAY_TLS_CERT_FILE/KEY_FILE at a cert.
# IDENTITY_UPSTREAM=http://localhost:8001
# CATALOG_UPSTREAM=http://localhost:8002
# STREAMING_UPSTREAM=http://localhost:8003
# AI_GUIDE_UPSTREAM=http://localhost:8004
# PAYMENTS_UPSTREAM=http://localhost:8005

# --- Shared infra ---
REDIS_URL=

# --- AI Guide ---
# AI_PROVIDER=mock
# AI_MODEL_GATEWAY_URL=http://localhost:8006
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Payments ---
# Leave STRIPE_SECRET_KEY empty in dev: the payments service uses a deterministic
# MockGateway so checkout/tips work offline. Set real keys to go live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Chat moderation (streaming, FR-9.1) ---
# Optional hosted classifier endpoint; the local rules engine always runs first.
# MODERATION_CLASSIFIER_URL=